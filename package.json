{
  "name": "nivra",
  "version": "1.7.1",
  "description": "Make documents easier on your eyes — a local-first Chrome extension that renders PDFs with real-time dark, invert, grayscale and contrast modes.",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "npx @tailwindcss/cli -i ./viewer/input.css -o ./viewer/viewer.css && node build.js",
    "package": "node package.js",
    "package:firefox": "node package-firefox.js",
    "package:opera": "node package-opera.js",
    "package:all": "npm run package && npm run package:opera && npm run package:firefox"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
